# Copie este arquivo para .env.local ao configurar o ambiente pela primeira vez.
# Este projeto usa Supabase local para desenvolvimento; nao aponte .env.local para staging.

# URL publica exposta pelo Supabase local para o app Next.js.
# O valor padrao do projeto eh http://127.0.0.1:55321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Chave anon do Supabase local.
# Gere/atualize automaticamente apos subir o stack com:
#   npm run local:env
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-after-running-npm-run-env-local

# String opcional para psql ou clientes SQL locais.
# O script `npm run local:env` tambem preenche esse valor no .env.local.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Contextos recomendados:
# - Desenvolvimento local: .env.local apontando para 127.0.0.1
# - Staging manual: mantenha credenciais em um arquivo ignorado, como .env.staging.local
# - Nunca commit credenciais reais de staging/producao

# Chave service-role (apenas servidor). Usada nas escritas da inscricao publica.
# Preenchida automaticamente pelo `npm run local:env`, junto com a anon key.
# Ignora RLS: nunca exponha no browser nem commite valores de staging/producao.
SUPABASE_SERVICE_ROLE_KEY=replace-after-running-npm-run-env-local

# --- Bloco C: e-mail transacional (Brevo) ---
# O caminho esta completo: a inscricao grava a linha em email_outbox e o dreno
# envia -- pelo submit, pelo "pagamento conferido" do admin, e pelo cron diario
# (vercel.json). Sem estas variaveis nenhum e-mail sai: o dreno LEVANTA sem as
# tres do Brevo, e ADIA toda linha sem NEXT_PUBLIC_SITE_URL. O resto do app roda
# normalmente.

# Chave v3 do Brevo, gerada em Settings > SMTP & API > Chaves de API.
# NAO sao as credenciais SMTP da mesma tela: o app fala HTTP, nao SMTP.
# Preenchida localmente, ela manda e-mail DE VERDADE e consome a mesma cota de
# 300/dia que staging e producao dividem. Deixe vazia para nao enviar nada.
BREVO_API_KEY=replace-me

# Tem de ser EXATAMENTE o remetente verificado no Brevo, ou a API recusa.
EMAIL_FROM=replace-me
EMAIL_FROM_NAME=CLS 2026

# Para onde vai o aviso de cada inscricao nova.
ORGANIZER_EMAIL=replace-me

# A base dos links do e-mail, com esquema e sem barra final.
# Local e o unico ambiente em que esse valor ja e conhecido: o `next dev`
# sobe na 3000. Em staging e producao o valor muda, e a base errada manda o
# jogador para o ambiente errado sem ele ter como saber.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do HMAC do link de descadastro (bloco C2). openssl rand -base64 32
EMAIL_TOKEN_SECRET=replace-me

# Protege /api/email/drain contra quem nao e o cron. openssl rand -base64 32
# Ausente, a rota RECUSA -- nunca "autoriza porque nao ha segredo".
# Local, preencha para conseguir chamar a rota a mao:
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/email/drain
CRON_SECRET=replace-me
