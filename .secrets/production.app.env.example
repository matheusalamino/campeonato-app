# Variaveis do APP para rodar local apontando para PRODUCAO.
# Copie para .secrets/production.app.env e preencha com os valores reais.
#
#   cp .secrets/production.app.env.example .secrets/production.app.env
#   npm run dev:production
#
# O comando pede confirmacao digitada antes de subir: a service-role ignora
# RLS, e a inscricao publica grava jogador e inscricao reais, podendo fechar
# as inscricoes de um campeonato de verdade.
#
# Os valores saem do painel do Supabase do projeto de producao,
# em Settings > API. Nao confundir com .secrets/production.env,
# que guarda credencial de Postgres para os dumps.

NEXT_PUBLIC_SUPABASE_URL=https://blcsqyawytmbnbpbzlvs.supabase.co

# Chave anon (publica, vai para o browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Chave service-role (apenas servidor). Ignora RLS.
# Nunca exponha no browser nem commite este arquivo.
SUPABASE_SERVICE_ROLE_KEY=replace-me
