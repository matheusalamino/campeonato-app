# Variaveis do APP para rodar local apontando para staging.
# Copie para .secrets/staging.app.env e preencha com os valores reais.
#
#   cp .secrets/staging.app.env.example .secrets/staging.app.env
#   npm run dev:staging
#
# Os valores saem do painel do Supabase do projeto de staging,
# em Settings > API. Nao confundir com .secrets/staging.env,
# que guarda credencial de Postgres para os dumps.

NEXT_PUBLIC_SUPABASE_URL=https://ydcevehrbmzkqqqcssvm.supabase.co

# Chave anon (publica, vai para o browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Chave service-role (apenas servidor). Ignora RLS.
# Nunca exponha no browser nem commite este arquivo.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Bloco C: e-mail transacional (Brevo) ---
# Chave v3 do Brevo, gerada em Settings > SMTP & API > Chaves de API.
# NAO sao as credenciais SMTP da mesma tela: o app fala HTTP, nao SMTP.
BREVO_API_KEY=replace-me

# Tem de ser EXATAMENTE o remetente verificado no Brevo, ou a API recusa.
EMAIL_FROM=replace-me
EMAIL_FROM_NAME=CLS 2026

# Para onde vai o aviso de cada inscricao nova.
ORGANIZER_EMAIL=replace-me

# A base dos links do e-mail. DIFERENTE POR AMBIENTE: com a base errada, o
# link de verificacao manda o jogador para o ambiente errado.
# Aqui vai a URL de staging, com esquema e sem barra final.
NEXT_PUBLIC_SITE_URL=replace-me

# Segredo do HMAC do link de descadastro (bloco C2). openssl rand -base64 32
EMAIL_TOKEN_SECRET=replace-me

# Protege o endpoint do dreno contra quem nao e o cron. openssl rand -base64 32
CRON_SECRET=replace-me
